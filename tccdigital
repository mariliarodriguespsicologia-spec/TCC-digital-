<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TCC Avançada v2 - Protocolo Completo</title>
    <style>
        :root {
            --primary: #1a2a6c;
            --secondary: #b21f1f;
            --accent: #fdbb2d;
            --bg: #f8f9fa;
            --card-bg: #ffffff;
            --text-main: #333;
        }

        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text-main); margin: 0; padding-bottom: 50px; }
        .app-header { background: linear-gradient(to right, var(--primary), var(--secondary)); color: white; padding: 15px; text-align: center; }
        .container { max-width: 800px; margin: auto; padding: 15px; }
        
        .card { background: var(--card-bg); border-radius: 12px; padding: 20px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }
        h2 { color: var(--primary); font-size: 1.2rem; border-bottom: 2px solid #eee; padding-bottom: 8px; margin-top: 0; }

        /* Navegação */
        .nav-tabs { display: flex; background: #e2e8f0; border-radius: 10px; margin-bottom: 20px; padding: 5px; }
        .tab-link { flex: 1; text-align: center; padding: 10px; cursor: pointer; border-radius: 8px; font-weight: bold; transition: 0.3s; }
        .tab-link.active { background: white; color: var(--primary); box-shadow: 0 2px 5px rgba(0,0,0,0.1); }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Inputs */
        textarea, input, select { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; margin-top: 5px; }
        label { display: block; margin-top: 15px; font-weight: 600; font-size: 0.9rem; color: #555; }

        /* Ativação Comportamental */
        .ac-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 10px; background: #f9fafb; padding: 10px; border-radius: 8px; margin-bottom: 10px; border: 1px solid #edf2f7; }
        .ac-header { font-weight: bold; font-size: 0.8rem; text-transform: uppercase; color: #718096; margin-bottom: 5px; }
        
        /* Badges de Distorções */
        .distortions-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
        .distortion-tag { background: #edf2f7; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem; cursor: pointer; border: 1px solid #cbd5e0; transition: 0.2s; }
        .distortion-tag.selected { background: var(--secondary); color: white; border-color: var(--secondary); }

        .btn-action { background: var(--primary); color: white; border: none; padding: 18px; border-radius: 10px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 20px; font-size: 1rem; }
        
        .helper-text { font-size: 0.8rem; color: #666; margin-top: 4px; font-style: italic; }
    </style>
</head>
<body>

<div class="app-header">
    <h1>Clínica TCC Digital</h1>
</div>

<div class="container">
    <div class="nav-tabs">
        <div class="tab-link active" onclick="switchTab('rpd', this)">Reestruturação</div>
        <div class="tab-link" onclick="switchTab('ativacao', this)">Ativação</div>
    </div>

    <section id="tab-rpd" class="tab-content active">
        <div class="card">
            <h2>Registro de Pensamentos (RPD)</h2>
            <label>Situação:</label>
            <textarea id="sit" placeholder="Ex: Enviei um email e não obtive resposta imediata."></textarea>
            
            <label>Pensamento Automático (PAN):</label>
            <textarea id="pan" placeholder="Ex: Estão a ignorar-me porque fiz algo errado."></textarea>
            
            <label>Emoção Inicial (0-100%):</label>
            <input type="range" id="emocao_antes" min="0" max="100" value="50">
            <div id="val_antes" style="text-align:center; font-weight:bold;">50%</div>
        </div>

        <div class="card">
            <h2>Desafio Socrático e Evidências</h2>
            <label>Provas que apoiam o pensamento:</label>
            <textarea id="provas_favor" rows="2"></textarea>
            
            <label>Provas que CONTRARIAM o pensamento:</label>
            <textarea id="provas_contra" rows="2" placeholder="O que mais poderia explicar a situação?"></textarea>
            
            <label>Identifique as Distorções:</label>
            <div class="distortions-list" id="distortions">
                <span class="distortion-tag" onclick="this.classList.toggle('selected')">Catastrofização</span>
                <span class="distortion-tag" onclick="this.classList.toggle('selected')">Leitura de Mente</span>
                <span class="distortion-tag" onclick="this.classList.toggle('selected')">Personalização</span>
                <span class="distortion-tag" onclick="this.classList.toggle('selected')">Pensamento Tudo-ou-Nada</span>
                <span class="distortion-tag" onclick="this.classList.toggle('selected')">Filtro Negativo</span>
            </div>
        </div>

        <div class="card">
            <h2>Conclusão Funcional</h2>
            <label>Pensamento Alternativo/Racional:</label>
            <textarea id="pens_alternativo" rows="3" placeholder="Uma visão mais equilibrada baseada nos factos..."></textarea>
            
            <label>Nova Intensidade da Emoção (0-100%):</label>
            <input type="range" id="emocao_depois" min="0" max="100" value="20">
            <div id="val_depois" style="text-align:center; font-weight:bold;">20%</div>
        </div>
        <button class="btn-action" onclick="saveData('RPD')">GUARDAR ANÁLISE COGNITIVA</button>
    </section>

    <section id="tab-ativacao" class="tab-content">
        <div class="card">
            <h2>Hierarquia de Atividades</h2>
            <p class="helper-text">Atribua valores de 0 a 10 para o que espera sentir.</p>
            
            <div id="ac-list">
                <div class="ac-row ac-header">
                    <div>Atividade</div>
                    <div>Prazer</div>
                    <div>Mestria</div>
                </div>
                <div class="ac-row">
                    <input type="text" placeholder="Ex: Arrumar a mesa" class="ac-task">
                    <input type="number" min="0" max="10" placeholder="0-10" class="ac-p">
                    <input type="number" min="0" max="10" placeholder="0-10" class="ac-m">
                </div>
                <div class="ac-row">
                    <input type="text" placeholder="Ex: Caminhada 5min" class="ac-task">
                    <input type="number" min="0" max="10" placeholder="0-10" class="ac-p">
                    <input type="number" min="0" max="10" placeholder="0-10" class="ac-m">
                </div>
            </div>
            <button onclick="addACRow()" style="background:#eee; border:1px solid #ccc; width:100%; padding:8px; border-radius:5px; cursor:pointer;">+ Adicionar Atividade</button>
        </div>

        <div class="card">
            <h2>O que é Prazer e Mestria?</h2>
            <ul style="font-size: 0.85rem; line-height: 1.4; color: #444;">
                <li><strong>Prazer:</strong> O quanto a atividade é agradável ou divertida.</li>
                <li><strong>Mestria:</strong> O sentimento de realização, dever cumprido ou competência (mesmo que não seja divertido).</li>
            </ul>
        </div>
        <button class="btn-action" onclick="saveData('AC')">GUARDAR PLANO DE ATIVAÇÃO</button>
    </section>
</div>

<script>
    // Gerenciamento de Abas
    function switchTab(tabId, el) {
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        document.querySelectorAll('.tab-link').forEach(l => l.classList.remove('active'));
        
        document.getElementById('tab-' + tabId).classList.add('active');
        el.classList.add('active');
    }

    // Atualização de Sliders
    document.getElementById('emocao_antes').oninput = function() { document.getElementById('val_antes').innerText = this.value + '%'; };
    document.getElementById('emocao_depois').oninput = function() { document.getElementById('val_depois').innerText = this.value + '%'; };

    // Adicionar Linhas na Ativação
    function addACRow() {
        const row = document.createElement('div');
        row.className = 'ac-row';
        row.innerHTML = `
            <input type="text" placeholder="Nova atividade" class="ac-task">
            <input type="number" min="0" max="10" placeholder="0-10" class="ac-p">
            <input type="number" min="0" max="10" placeholder="0-10" class="ac-m">
        `;
        document.getElementById('ac-list').appendChild(row);
    }

    // Guardar Dados
    function saveData(tipo) {
        let dataToSave = {};
        
        if(tipo === 'RPD') {
            dataToSave = {
                tipo: 'Reestruturação',
                sit: document.getElementById('sit').value,
                pan: document.getElementById('pan').value,
                reducao: document.getElementById('emocao_antes').value - document.getElementById('emocao_depois').value
            };
        } else {
            const tasks = Array.from(document.querySelectorAll('.ac-row:not(.ac-header)')).map(row => ({
                task: row.querySelector('.ac-task').value,
                p: row.querySelector('.ac-p').value,
                m: row.querySelector('.ac-m').value
            }));
            dataToSave = { tipo: 'Ativação', atividades: tasks };
        }

        localStorage.setItem('tcc_log_' + Date.now(), JSON.stringify(dataToSave));
        alert("Dados de " + tipo + " guardados no dispositivo!");
    }
</script>

</body>
</html>
